# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# PostgreSQL used by docker-compose
# NOTE: POSTGRES_* only take effect the first time the volume is created.
# If you change them later, run: docker compose down -v (this deletes data).
# ---------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password

# ---------------------------------------------------------------------------
# Only needed when running the app on the host (./mvnw spring-boot:run).
# The host port must match the one published in docker-compose.yml (5432).
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres

# ---------------------------------------------------------------------------
# JWT
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-secret
JWT_MINUTES=60
SEED_OWNER_PASSWORD=change-this-owner-password
